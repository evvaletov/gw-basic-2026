  "capture_source": "10 SCREEN 0:SCREEN 1:GOSUB 64000:N=1:GOSUB 65000\n20 COLOR ,0:N=2:GOSUB 65000\n30 COLOR ,1:N=3:GOSUB 65000\n40 COLOR 1:N=4:GOSUB 65000\n50 COLOR 15:N=5:GOSUB 65000\n60 COLOR 16:N=6:GOSUB 65000\n70 COLOR 31:N=7:GOSUB 65000\n80 COLOR 255,2:N=8:GOSUB 65000\n90 SCREEN 1:N=9:GOSUB 65000\n100 OUT &H3D9,0:N=10:GOSUB 65000\n110 OUT &H3D9,16:N=11:GOSUB 65000\n120 OUT &H3D9,32:N=12:GOSUB 65000\n130 OUT &H3D9,48:N=13:GOSUB 65000\n140 OUT &H3D9,63:N=14:GOSUB 65000\n150 OUT &H3D9,1:N=15:GOSUB 65000\n160 COLOR ,1:N=16:GOSUB 65000\n170 COLOR 0,0:N=17:GOSUB 65000\n180 SCREEN 1:N=18:GOSUB 65000\n190 SCREEN 0:SCREEN 1:GOSUB 64000:N=19:GOSUB 65000\n60000 SCREEN 0:SYSTEM\n64000 FOR C=0 TO 3:LINE (C*80,40)-(C*80+79,100),C,BF:NEXT C:RETURN\n65000 FOR B=0 TO 5:C=2:IF N AND 2^B THEN C=1\n65010 LINE (B*20,170)-(B*20+19,185),C,BF:NEXT B\n65020 FOR J=1 TO 5000:NEXT J:RETURN\n",
