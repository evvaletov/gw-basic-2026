  1 REM public domain, nenies proprajho, free for any use

 10 DEFINT A-Z
 20 OPEN "INVADERS.ASM" FOR INPUT AS #1
 21 OPEN "hexnum.out" FOR OUTPUT AS #2
 30 IF EOF(1) <> 0 THEN GOTO 50
 31 LINE INPUT #1,L$
 32 N=N+1: K=K+1: IF K=300 THEN PRINT "line ";N: K=0
 33 Q=FALSE: LL=LEN(L$): IF LL=0 THEN Q=NOT FALSE
 34 IF MID$(L$,1,1)=";" THEN Q=NOT FALSE
 35 IF Q=0 THEN S=1: T$="h": GOSUB 600: IF F > 0 THEN GOSUB 300
 36 IF Q=0 THEN PRINT #2,L$
 40 GOTO 30
 50 CLOSE #2: CLOSE #1
 99 SYSTEM

200 REM (found)
201 FO=FALSE: KO=NOT FALSE
210 IF Y > LL THEN GOTO 299
211 IF KO=0 THEN GOTO 299
212 IF Y=0 THEN GOTO 299
213 M=0: IF MID$(L$,Y,1) <> "" THEN M=ASC(MID$(L$,Y,1))
214 IF M >= ASC("0") THEN IF M <= ASC("9") THEN IF Y < LL THEN GOSUB 400
215 Y=Y+1
220 GOTO 210
299 RETURN

300 REM (fixhexes)
301 Y=1: GOSUB 200
310 IF FO=0 THEN GOTO 399
320 L$=MID$(L$,1,XB-1) + "0x" + MID$(L$,XB,XE+1-XB) + MID$(L$,XE+2)
321 LL=LL+2: GOSUB 200
330 GOTO 310
399 RETURN

400 REM (meh)
401 XB=Y: Z=Y+1
410 GOSUB 500: IF F=0 THEN GOTO 430
411 IF Z=LL THEN GOTO 430
412 Z=Z+1
420 GOTO 410
430 IF MID$(L$,Z,1)="h" THEN XE=Z-1: FO=NOT FALSE: KO=FALSE
499 RETURN

500 REM (isxdigit)
501 F=0: M=0: IF MID$(L$,Z,1) <> "" THEN M=ASC(MID$(L$,Z,1))
502 IF M >= ASC("0") THEN IF M <= ASC("9") THEN F=1: GOTO 599
503 IF M >= ASC("a") THEN IF M <= ASC("f") THEN M=M-ASC(" ")
504 IF M >= ASC("A") THEN IF M <= ASC("F") THEN F=1
599 RETURN

600 REM (search)
601 A=LEN(T$): B=LEN(L$)+1-A: F=0: I=S
610 IF I > B THEN GOTO 699
611 IF MID$(L$,I,A)=T$ THEN F=I: I=B
612 I=I+1
620 GOTO 610
699 RETURN
