  1 REM TIDY.BAS SHRINKS BLOATED WHITESPACE FROM INVADERS.ASM
  2 REM PUBLIC DOMAIN, NENIES PROPRAJHO, FREE FOR ANY USE
  3 REM WHILE WEND CAN BE CHANGED TO GOTOS IF NEEDED
 10 DEFINT A-Z
 20 OPEN "INVADERS.ASM" FOR INPUT AS #1
 21 OPEN "TIDY.ASM" FOR OUTPUT AS #2
 30 WHILE EOF(1) = FALSE
 40 LINE INPUT #1,L$
 41 N=N+1 : K=K+1 : IF K=300 THEN PRINT "LINE ";N : K=0
 50 Y=0 : IF LEN(L$)=0 THEN Y=1
 51 IF MID$(L$,1,1)=";" THEN Y=1
 52 IF Y=0 THEN GOSUB 200 : GOSUB 300
 53 IF Y=0 THEN IF LEN(L$) > 0 THEN PRINT #2,L$
 60 WEND
 90 CLOSE #2 : CLOSE #1
 99 SYSTEM
200 REM (NOTABS)
201 S=1 : T$=CHR$(9) : GOSUB 700 : P=F
210 WHILE P > 0
211 MID$(L$,P,1)=" "
212 S=P : GOSUB 700 : P=F
220 WEND
299 RETURN
300 REM (SHRINK)
301 C$=MID$(L$,LEN(L$)-2,3) : IF C$=CHR$(34) + ",0" THEN Y=1
302 IF Y=0 THEN GOSUB 500
303 IF Y=1 THEN Y=0 : GOSUB 400
304 S=1 : T$=";" : GOSUB 700 : P=F : IF P > 0 THEN L$=MID$(L$,1,P-1)
305 T$=L$ : GOSUB 600 : L$=T$
399 RETURN
400 REM (DBLQUOTE)
401 S=1 : T$=" " : GOSUB 700 : P=F
402 T$=MID$(L$,P) : GOSUB 600 : A$=MID$(T$,1,2)
403 S=P : T$=CHR$(34) : GOSUB 700: B$=MID$(L$,F)
404 L$=MID$(L$,1,P-1) + " " + A$ + " " + B$
499 RETURN
500 REM (NOQUOTE)
501 S=1 : T$=" " + " " : GOSUB 700 : P=F
510 WHILE P > 0
511 Q=P
520 WHILE MID$(L$,Q,1)=" "
521 Q=Q+1
530 WEND
531 L$=MID$(L$,1,P) + MID$(L$,Q) : S=P : T$=" " + " " : GOSUB 700 : P=F
540 WEND
599 RETURN
600 REM (TRIM)
601 I=1 : IF LEN(T$)=0 THEN RETURN
610 WHILE MID$(T$,I,1)=" "
611 I=I+1
620 WEND
621 T$=MID$(T$,I)
622 I=LEN(T$) : IF I=0 THEN RETURN
630 WHILE MID$(T$,I,1)=" "
631 I=I-1
640 WEND
641 IF I > 0 THEN T$=MID$(T$,1,I)
699 RETURN
700 REM (SEARCH)
701 REM F=INSTR(S,L$,T$) : RETURN
702 A=LEN(T$) : B=LEN(L$)+1-A : F=0 : I=S
710 WHILE I <= B
711 IF MID$(L$,I,A)=T$ THEN F=I : I=B
712 I=I+1
720 WEND
799 RETURN
