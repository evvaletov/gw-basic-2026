1 REM  "public domain, nenies proprajho, free for any use"
10 DATA   3, 4, 5, 6,12,14,15,17,18,19,20,21,22,23,27
11 DATA  33,36,39,42,86, 0
13 OPEN  "INVADERS.ASM" FOR  INPUT  AS #1
14 OPEN  "inv.inc" FOR  OUTPUT AS #2
15 OPEN  "inv.a86" FOR  OUTPUT AS #3
20 WHILE  NOT  EOF(1)
30 LINE  INPUT  #1,A$
31 LET  N=N+1 : LET  K=K+1
32 IF  K=300 THEN  PRINT  "; LINE ";N : LET  K=0
33 IF  LEN(A$)=0 THEN  GOTO  90
34 IF  MID$(A$,1,1)=";" THEN  GOTO  90
40 REM 
60 GOSUB  200 : GOSUB  300 : GOSUB  400
70 IF  W1$="JMP" THEN  GOSUB  500
80 PRINT  #3,A$
90 WEND 
100 CLOSE  #3 : CLOSE  #2 : CLOSE  #1 : SYSTEM
200 LET  L=LEN(A$)
201 FOR  I=1 TO  L-1
202 LET  Y=ASC(MID$(A$,I,1))
203 IF  Y=9 THEN  LET  A$=MID$(A$,1,I-1) + " " + MID$(A$,I+1)
204 NEXT 
205 IF  L <= 3 THEN  GOTO  299
206 IF  MID$(A$,L-2,3)="[0]" THEN  LET  A$=MID$(A$,1,L-3)
299 RETURN 
300 LET  I=0
301 LET  I=I+1
302 IF  MID$(A$,I,1)=" " THEN  GOTO  301
303 LET  A$=MID$(A$,I)
304 LET  I=1 : LET  L=LEN(A$) : LET  W1$=A$ : LET  W2$="" : LET  Y=0
310 LET  I=I+1 : IF  I=L THEN  GOTO  399
311 IF  MID$(A$,I,1) <> " " THEN  GOTO  310
312 LET  W1$=MID$(A$,1,I-1) : LET  W2$=MID$(A$,I)
313 LET  I=0 : LET  L=LEN(W2$)
320 LET  I=I+1 : IF  I=L THEN  GOTO  399
321 IF  MID$(W2$,I,1)=" " THEN  GOTO  320
322 LET  W2$=MID$(W2$,I) : LET  I=0 : LET  L=LEN(W2$)
330 LET  I=I+1 : IF  I=L THEN  GOTO  399
331 IF  MID$(W2$,I,1)=" " THEN  LET  Y=1
332 IF  MID$(W2$,I,1)="," THEN  LET  Y=1
333 IF  Y=1 THEN  LET  W2$=MID$(W2$,1,I-1) : LET  L=LEN(W2$)
334 IF  Y=0 THEN  GOTO  330
340 IF  W2$ <> "DB" THEN  IF  W2$ <> "DW" THEN  GOTO  399
350 PRINT  #2,"EXTRN ";W1$;":";MID$(W2$,2,1)
399 RETURN 
400 IF  W2$="PROC" THEN  IF  W1$="RemoveNewInt9" THEN  LET  S=1
401 IF  W2$="PROC" THEN  IF  W1$="DrawBunkers" THEN  LET  S=0
402 IF  S=0 THEN  GOTO  499
403 IF  W1$ <> "MOV" THEN  GOTO  499
404 IF  W2$="DS" THEN  GOTO  499
405 IF  W2$="AH" THEN  GOTO  499
406 IF  W2$="AL" THEN  GOTO  499
407 LET  I=0 : LET  L=LEN(A$) : LET  Y=0
410 LET  I=I+1 : IF  MID$(A$,I,1)=":" THEN  LET  Y=1
411 IF  Y=1 THEN  LET  A$=MID$(A$,1,I-3) + MID$(A$,I+1) : GOTO  499
412 IF  I <> L THEN  GOTO  410
413 LET  A$="CS " + A$
499 RETURN 
500 LET  J=J+1 : IF  J >= 44 THEN  IF  J <= 67 THEN  GOTO  599
510 READ  I
511 IF  J=I THEN  GOTO  590
512 IF  I <> 0 THEN  GOTO  510
520 LET  A$=W1$ + " SHORT " + W2$
590 RESTORE 
599 RETURN 
